diff --git a/openair2/RRC/NR/MESSAGES/tests/test_asn1_msg.cpp b/openair2/RRC/NR/MESSAGES/tests/test_asn1_msg.cpp
--- a/openair2/RRC/NR/MESSAGES/tests/test_asn1_msg.cpp
+++ b/openair2/RRC/NR/MESSAGES/tests/test_asn1_msg.cpp
@@
 TEST(nr_asn1, harp_snpn_npn_codec)
 {
@@
   ASN_STRUCT_FREE_CONTENTS_ONLY(asn_DEF_NR_NPN_IdentityInfoList_r16, &original);
 }
+
+TEST(nr_asn1, harp_snpn_selection)
+{
+  NR_SIB1_t sib1 = {};
+  sib1.cellAccessRelatedInfo.ext1 =
+      (struct NR_CellAccessRelatedInfo__ext1 *)calloc_or_fail(
+          1, sizeof(*sib1.cellAccessRelatedInfo.ext1));
+  sib1.cellAccessRelatedInfo.ext1->npn_IdentityInfoList_r16 =
+      (NR_NPN_IdentityInfoList_r16_t *)calloc_or_fail(
+          1,
+          sizeof(*sib1.cellAccessRelatedInfo.ext1->npn_IdentityInfoList_r16));
+
+  auto *info = (NR_NPN_IdentityInfo_r16_t *)calloc_or_fail(1, sizeof(*info));
+  ASSERT_EQ(
+      ASN_SEQUENCE_ADD(
+          &sib1.cellAccessRelatedInfo.ext1->npn_IdentityInfoList_r16->list,
+          info),
+      0);
+
+  auto *identity = (NR_NPN_Identity_r16_t *)calloc_or_fail(1, sizeof(*identity));
+  ASSERT_EQ(ASN_SEQUENCE_ADD(&info->npn_IdentityList_r16.list, identity), 0);
+  identity->present = NR_NPN_Identity_r16_PR_snpn_r16;
+  identity->choice.snpn_r16 =
+      (struct NR_NPN_Identity_r16__snpn_r16 *)calloc_or_fail(
+          1, sizeof(*identity->choice.snpn_r16));
+  fill_test_plmn(&identity->choice.snpn_r16->plmn_Identity_r16, 999, 99);
+
+  auto *nid = (NR_NID_r16_t *)calloc_or_fail(1, sizeof(*nid));
+  const uint8_t nid_bytes[] = {0x10, 0x00, 0x00, 0x00, 0x00, 0x10};
+  fill_test_bit_string(nid, nid_bytes, sizeof(nid_bytes), 4);
+  ASSERT_EQ(
+      ASN_SEQUENCE_ADD(&identity->choice.snpn_r16->nid_List_r16.list, nid),
+      0);
+
+  const plmn_id_t target = {
+      .mcc = 999,
+      .mnc = 99,
+      .mnc_digit_length = 2,
+  };
+  plmn_id_t selected = {};
+  uint64_t selected_nid = 0;
+
+  ASSERT_TRUE(nr_sib1_find_snpn(
+      &sib1,
+      &target,
+      0x10000000001ULL,
+      &selected,
+      &selected_nid));
+  EXPECT_EQ(selected.mcc, 999);
+  EXPECT_EQ(selected.mnc, 99);
+  EXPECT_EQ(selected.mnc_digit_length, 2);
+  EXPECT_EQ(selected_nid, 0x10000000001ULL);
+
+  selected = {};
+  selected_nid = 0;
+  EXPECT_FALSE(nr_sib1_find_snpn(
+      &sib1,
+      &target,
+      0x10000000002ULL,
+      &selected,
+      &selected_nid));
+
+  NR_NID_r16_t malformed = {};
+  const uint8_t bad_padding[] = {0x10, 0x00, 0x00, 0x00, 0x00, 0x11};
+  fill_test_bit_string(&malformed, bad_padding, sizeof(bad_padding), 4);
+  uint64_t malformed_value = 0;
+  EXPECT_FALSE(nr_decode_nid44(&malformed, &malformed_value));
+  ASN_STRUCT_FREE_CONTENTS_ONLY(asn_DEF_NR_NID_r16, &malformed);
+
+  NR_NID_r16_t missing_buf = {};
+  missing_buf.size = 6;
+  missing_buf.bits_unused = 4;
+  EXPECT_FALSE(nr_decode_nid44(&missing_buf, &malformed_value));
+
+  const plmn_id_t wrong_plmn = {
+      .mcc = 998,
+      .mnc = 99,
+      .mnc_digit_length = 2,
+  };
+  EXPECT_FALSE(nr_sib1_find_snpn(
+      &sib1,
+      &wrong_plmn,
+      0x10000000001ULL,
+      &selected,
+      &selected_nid));
+
+  printf("PASS_V5G_SNPN_SELECT_UNIT\n");
+  ASN_STRUCT_FREE_CONTENTS_ONLY(asn_DEF_NR_SIB1, &sib1);
+}
