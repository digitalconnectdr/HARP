From HARP research branch
Subject: [PATCH 3b] gNB: encode SNPN identity in SIB1

Depends on:
  0003a-gnb-snpn-config-plumbing.patch

Upstream anchor:
  openairinterface/openairinterface5g
  f8f769592a7030be88ede4bb5ca66fa1ca6a80e0

ASN.1 grammar verified from the exact Git blob:
  CellAccessRelatedInfo
    -> npn-IdentityInfoList-r16
      -> NPN-IdentityInfo-r16
        -> npn-IdentityList-r16
          -> NPN-Identity-r16
            -> snpn-r16
              -> plmn-Identity-r16
              -> nid-List-r16
                -> NID-r16 BIT STRING (SIZE(44))

The generated C spellings below were cross-checked against a public OAI Rel-16
build artifact produced with asn1c -fcompound-names. In particular:
- npn_IdentityInfoList_r16 is under CellAccessRelatedInfo.ext1;
- choice.snpn_r16 is a pointer;
- NR_NPN_Identity_r16_PR_snpn_r16 and the notReserved enum names were confirmed.

Rel-17.3.0 keeps the same first extension group in the ASN.1 grammar, with the
r17 SNPN access-info list in a later extension group. A real build against the
pinned OAI generated headers is still required before claiming
PASS_V5G_SNPN_SIB1_CODEC.

diff --git a/openair2/LAYER2/NR_MAC_gNB/nr_radio_config.c b/openair2/LAYER2/NR_MAC_gNB/nr_radio_config.c
--- a/openair2/LAYER2/NR_MAC_gNB/nr_radio_config.c
+++ b/openair2/LAYER2/NR_MAC_gNB/nr_radio_config.c
@@
 #include "nr_radio_config.h"
+#include "NR_NID-r16.h"
+#include "NR_NPN-Identity-r16.h"
+#include "NR_NPN-IdentityInfo-r16.h"
+#include "NR_NPN-IdentityInfoList-r16.h"
@@
+static void fill_plmn_identity(NR_PLMN_Identity_t *dst, const plmn_id_t *plmn)
+{
+  asn1cCalloc(dst->mcc, mcc);
+  const int conf_mcc = plmn->mcc;
+  asn1cSequenceAdd(mcc->list, NR_MCC_MNC_Digit_t, mcc0);
+  *mcc0 = (conf_mcc / 100) % 10;
+  asn1cSequenceAdd(mcc->list, NR_MCC_MNC_Digit_t, mcc1);
+  *mcc1 = (conf_mcc / 10) % 10;
+  asn1cSequenceAdd(mcc->list, NR_MCC_MNC_Digit_t, mcc2);
+  *mcc2 = conf_mcc % 10;
+
+  const int mnc = plmn->mnc;
+  if (plmn->mnc_digit_length == 3) {
+    asn1cSequenceAdd(dst->mnc.list, NR_MCC_MNC_Digit_t, mnc0);
+    *mnc0 = (mnc / 100) % 10;
+  }
+  asn1cSequenceAdd(dst->mnc.list, NR_MCC_MNC_Digit_t, mnc1);
+  *mnc1 = (mnc / 10) % 10;
+  asn1cSequenceAdd(dst->mnc.list, NR_MCC_MNC_Digit_t, mnc2);
+  *mnc2 = mnc % 10;
+}
+
+static bool nid44_to_bit_string(uint64_t nid, BIT_STRING_t *out)
+{
+  if (out == NULL || nid > 0xFFFFFFFFFFFULL)
+    return false;
+
+  const uint64_t shifted = nid << 4;
+  out->buf = calloc_or_fail(6, sizeof(*out->buf));
+  out->size = 6;
+  out->bits_unused = 4;
+  for (int i = 0; i < 6; ++i)
+    out->buf[i] = (shifted >> (40 - 8 * i)) & 0xff;
+  return true;
+}
+
+static void fill_tracking_area_code(NR_TrackingAreaCode_t *dst, int tac)
+{
+  uint32_t be = htobe32(tac);
+  dst->buf = calloc_or_fail(3, sizeof(*dst->buf));
+  memcpy(dst->buf, ((char *)&be) + 1, 3);
+  dst->size = 3;
+  dst->bits_unused = 0;
+}
+
+static void add_snpn_identity_to_sib1(
+    NR_SIB1_t *sib1,
+    const plmn_id_t *plmn,
+    uint64_t cell_id,
+    int tac,
+    uint64_t nid)
+{
+  AssertFatal(nid <= 0xFFFFFFFFFFFULL, "SNPN NID exceeds 44 bits\n");
+
+  asn1cCalloc(
+      sib1->cellAccessRelatedInfo.ext1,
+      cell_access_ext1);
+  asn1cCalloc(
+      cell_access_ext1->npn_IdentityInfoList_r16,
+      npn_info_list);
+  asn1cSequenceAdd(
+      npn_info_list->list,
+      struct NR_NPN_IdentityInfo_r16,
+      npn_info);
+
+  asn1cSequenceAdd(
+      npn_info->npn_IdentityList_r16.list,
+      struct NR_NPN_Identity_r16,
+      npn_identity);
+  npn_identity->present = NR_NPN_Identity_r16_PR_snpn_r16;
+  asn1cCalloc(npn_identity->choice.snpn_r16, snpn);
+
+  fill_plmn_identity(&snpn->plmn_Identity_r16, plmn);
+
+  asn1cSequenceAdd(
+      snpn->nid_List_r16.list,
+      NR_NID_r16_t,
+      nid_ie);
+  AssertFatal(
+      nid44_to_bit_string(nid, nid_ie),
+      "Unable to encode 44-bit SNPN NID\n");
+
+  fill_tracking_area_code(&npn_info->trackingAreaCode_r16, tac);
+  NR_CELL_ID_TO_BIT_STRING(cell_id, &npn_info->cellIdentity_r16);
+  npn_info->cellReservedForOperatorUse_r16 =
+      NR_NPN_IdentityInfo_r16__cellReservedForOperatorUse_r16_notReserved;
+
+  LOG_I(
+      NR_RRC,
+      "HARP_SNPN_BROADCAST mcc=%d mnc=%d nid=%011llX bits=44\n",
+      plmn->mcc,
+      plmn->mnc,
+      (unsigned long long)nid);
+}
+
 NR_BCCH_DL_SCH_Message_t *get_SIB1_NR(const NR_ServingCellConfigCommon_t *scc,
                                       const plmn_id_t *plmn,
                                       uint64_t cellID,
@@
   asn1cSequenceAdd(sib1->cellAccessRelatedInfo.plmn_IdentityInfoList.list, struct NR_PLMN_IdentityInfo, nr_plmn_info);
   for (int i = 0; i < num_plmn; ++i) {
     asn1cSequenceAdd(nr_plmn_info->plmn_IdentityList.list, struct NR_PLMN_Identity, nr_plmn);
