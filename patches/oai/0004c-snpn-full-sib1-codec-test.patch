From HARP research branch
Subject: [PATCH 4c] tests: dedicated full SIB1 SNPN encode/decode gate

Depends on:
  0003a-gnb-snpn-config-plumbing.patch
  0003b-gnb-snpn-sib1-encoding.patch
  0004b-nr-ue-snpn-selection-unit-test.patch

Upstream anchor:
  openairinterface/openairinterface5g
  f8f769592a7030be88ede4bb5ca66fa1ca6a80e0

Gate:
  PASS_V5G_SNPN_SIB1_CODEC

The test is a standalone C executable under tests/nrdlbench. It reuses the
same link group and framework stubs already proven by nr_dlbench, while
keeping the lightweight RRC GTest target unchanged.

It uses the same SCC fixture path as OAI PHY simulations:
  prepare_scc()
  fill_scc_sim()
  fix_scc()

Then:
  get_SIB1_NR()
  encode_SIB_NR()
  uper_decode()
  nr_sib1_find_snpn()

It also verifies that disabling SNPN leaves the NPN identity list absent.

diff --git a/tests/nrdlbench/CMakeLists.txt b/tests/nrdlbench/CMakeLists.txt
--- a/tests/nrdlbench/CMakeLists.txt
+++ b/tests/nrdlbench/CMakeLists.txt
@@
   add_test(NAME nr_dlbench_am_functional_test
            COMMAND ${CMAKE_CURRENT_SOURCE_DIR}/nr-dlbench-functional-test.sh $<TARGET_FILE:nr_dlbench> -A 50)
+
+  add_executable(test_snpn_sib1_codec
+    test_snpn_sib1_codec.c)
+  target_link_libraries(test_snpn_sib1_codec PRIVATE
+    -Wl,--start-group
+    UTIL SIMU PHY_NR_COMMON PHY_NR SCHED_NR_LIB MAC_NR_COMMON CONFIG_LIB L2_NR nr_rrc
+    -Wl,--end-group
+    m pthread ${T_LIB} ITTI dl physim_common time_management_core
+    softmodem_common
+  )
+  target_link_libraries(test_snpn_sib1_codec PRIVATE
+    asn1_nr_rrc_hdrs asn1_lte_rrc_hdrs)
+  add_dependencies(tests test_snpn_sib1_codec)
+  add_test(NAME test_snpn_sib1_codec
+           COMMAND $<TARGET_FILE:test_snpn_sib1_codec>)
 endif()

diff --git a/tests/nrdlbench/test_snpn_sib1_codec.c b/tests/nrdlbench/test_snpn_sib1_codec.c
