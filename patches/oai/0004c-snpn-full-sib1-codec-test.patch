From HARP research branch
Subject: [PATCH 4c] NR RRC tests: dedicated full SIB1 SNPN encode/decode gate

Depends on:
  0003a-gnb-snpn-config-plumbing.patch
  0003b-gnb-snpn-sib1-encoding.patch
  0004b-nr-ue-snpn-selection-unit-test.patch

Upstream anchor:
  openairinterface/openairinterface5g
  f8f769592a7030be88ede4bb5ca66fa1ca6a80e0

Gate:
  PASS_V5G_SNPN_SIB1_CODEC

This creates a dedicated test target so the existing lightweight
test_asn1_msg target does not inherit L2_NR.

The test uses the same SCC fixture path as OAI PHY simulations:
  prepare_scc()
  fill_scc_sim()
  fix_scc()

Then:
  get_SIB1_NR()
  encode_SIB_NR()
  uper_decode()
  nr_sib1_find_snpn()

It also verifies that disabling SNPN leaves the NPN identity list absent.

diff --git a/openair2/RRC/NR/MESSAGES/tests/CMakeLists.txt b/openair2/RRC/NR/MESSAGES/tests/CMakeLists.txt
--- a/openair2/RRC/NR/MESSAGES/tests/CMakeLists.txt
+++ b/openair2/RRC/NR/MESSAGES/tests/CMakeLists.txt
@@
 add_test(NAME test_asn1_msg
     COMMAND ./test_asn1_msg)
+
+add_executable(test_snpn_sib1_codec
+  test_snpn_sib1_codec.cpp)
+target_link_libraries(test_snpn_sib1_codec PRIVATE
+  -Wl,--start-group
+  L2_NR nr_rrc CONFIG_LIB ITTI SECURITY minimal_lib UTIL nr_common GTest::gtest
+  -Wl,--end-group)
+add_dependencies(tests test_snpn_sib1_codec)
+add_test(NAME test_snpn_sib1_codec
+    COMMAND ./test_snpn_sib1_codec)

diff --git a/openair2/RRC/NR/MESSAGES/tests/test_snpn_sib1_codec.cpp b/openair2/RRC/NR/MESSAGES/tests/test_snpn_sib1_codec.cpp
new file mode 100644
--- /dev/null
+++ b/openair2/RRC/NR/MESSAGES/tests/test_snpn_sib1_codec.cpp
@@
+/*
+ * SPDX-License-Identifier: LicenseRef-CSSL-1.0
+ */
+
+#include <gtest/gtest.h>
+
+#include <cstdint>
+#include <cstdlib>
+
+extern "C" {
+#include "common/ran_context.h"
+#include "common/utils/assertions.h"
+#include "openair2/LAYER2/NR_MAC_gNB/nr_radio_config.h"
+#include "openair2/RRC/NR/MESSAGES/asn1_msg.h"
+#include "NR_BCCH-DL-SCH-Message.h"
+#include "NR_ServingCellConfigCommon.h"
+#include "per_decoder.h"
+}
+
+RAN_CONTEXT_t RC;
+
+extern "C" {
+void prepare_scc(NR_ServingCellConfigCommon_t *scc);
+void fill_scc_sim(
+    NR_ServingCellConfigCommon_t *scc,
+    uint64_t *ssb_bitmap,
+    int N_RB_DL,
+    int N_RB_UL,
+    int mu_dl,
+    int mu_ul);
+void fix_scc(NR_ServingCellConfigCommon_t *scc, uint64_t ssbmap);
+}
+
+static nr_mac_config_t harp_sib1_test_config(
+    bool snpn_enabled,
+    uint64_t nid)
+{
+  nr_mac_config_t config = {};
+  config.timer_config.t300 = 1000;
+  config.timer_config.t301 = 1000;
+  config.timer_config.t310 = 1000;
+  config.timer_config.n310 = 1;
+  config.timer_config.t311 = 30000;
+  config.timer_config.n311 = 1;
+  config.timer_config.t319 = 1000;
+  config.snpn.enabled = snpn_enabled;
+  config.snpn.nid = nid;
+  return config;
+}
+
+static NR_BCCH_DL_SCH_Message_t *harp_build_and_decode_sib1(
+    bool snpn_enabled,
+    uint64_t nid)
+{
+  NR_ServingCellConfigCommon_t *scc =
+      static_cast<NR_ServingCellConfigCommon_t *>(
+          calloc_or_fail(1, sizeof(*scc)));
+  prepare_scc(scc);
+  uint64_t ssb_bitmap = 1;
+  fill_scc_sim(scc, &ssb_bitmap, 106, 106, 1, 1);
+  fix_scc(scc, ssb_bitmap);
+
+  const plmn_id_t plmn = {
+      .mcc = 999,
+      .mnc = 99,
+      .mnc_digit_length = 2,
+  };
+  const nr_mac_config_t config =
+      harp_sib1_test_config(snpn_enabled, nid);
+
+  NR_BCCH_DL_SCH_Message_t *built =
+      get_SIB1_NR(scc, &plmn, 0x12345, 1, &config);
+  EXPECT_NE(built, nullptr);
+  if (!built) {
+    ASN_STRUCT_FREE(asn_DEF_NR_ServingCellConfigCommon, scc);
+    return nullptr;
+  }
+
+  uint8_t encoded[4096] = {0};
+  const int encoded_len =
+      encode_SIB_NR(built, encoded, sizeof(encoded));
+  EXPECT_GT(encoded_len, 0);
+  if (encoded_len <= 0) {
+    free_SIB1_NR(built);
+    ASN_STRUCT_FREE(asn_DEF_NR_ServingCellConfigCommon, scc);
+    return nullptr;
+  }
+
+  NR_BCCH_DL_SCH_Message_t *decoded = nullptr;
+  const asn_dec_rval_t dec = uper_decode(
+      nullptr,
+      &asn_DEF_NR_BCCH_DL_SCH_Message,
+      reinterpret_cast<void **>(&decoded),
+      encoded,
+      encoded_len,
+      0,
+      0);
+  EXPECT_EQ(dec.code, RC_OK);
+  EXPECT_NE(decoded, nullptr);
+
+  free_SIB1_NR(built);
+  ASN_STRUCT_FREE(asn_DEF_NR_ServingCellConfigCommon, scc);
+  return decoded;
+}
+
+TEST(harp_snpn, full_sib1_codec)
+{
+  NR_BCCH_DL_SCH_Message_t *decoded =
+      harp_build_and_decode_sib1(true, 0x10000000001ULL);
+  ASSERT_NE(decoded, nullptr);
+  ASSERT_EQ(decoded->message.present, NR_BCCH_DL_SCH_MessageType_PR_c1);
+  ASSERT_NE(decoded->message.choice.c1, nullptr);
+  ASSERT_EQ(
+      decoded->message.choice.c1->present,
+      NR_BCCH_DL_SCH_MessageType__c1_PR_systemInformationBlockType1);
+
+  const NR_SIB1_t *sib1 =
+      decoded->message.choice.c1->choice.systemInformationBlockType1;
+  ASSERT_NE(sib1, nullptr);
+
+  const plmn_id_t target = {
+      .mcc = 999,
+      .mnc = 99,
+      .mnc_digit_length = 2,
+  };
+  plmn_id_t selected = {};
+  uint64_t selected_nid = 0;
+  ASSERT_TRUE(nr_sib1_find_snpn(
+      sib1,
+      &target,
+      0x10000000001ULL,
+      &selected,
+      &selected_nid));
+  EXPECT_EQ(selected.mcc, 999);
+  EXPECT_EQ(selected.mnc, 99);
+  EXPECT_EQ(selected.mnc_digit_length, 2);
+  EXPECT_EQ(selected_nid, 0x10000000001ULL);
+
+  ASN_STRUCT_FREE(asn_DEF_NR_BCCH_DL_SCH_Message, decoded);
+
+  decoded = harp_build_and_decode_sib1(false, 0);
+  ASSERT_NE(decoded, nullptr);
+  ASSERT_EQ(decoded->message.present, NR_BCCH_DL_SCH_MessageType_PR_c1);
+  ASSERT_NE(decoded->message.choice.c1, nullptr);
+  sib1 = decoded->message.choice.c1->choice.systemInformationBlockType1;
+  ASSERT_NE(sib1, nullptr);
+  EXPECT_TRUE(
+      sib1->cellAccessRelatedInfo.ext1 == nullptr
+      || sib1->cellAccessRelatedInfo.ext1->npn_IdentityInfoList_r16 == nullptr);
+
+  std::printf("PASS_V5G_SNPN_SIB1_CODEC\n");
+  ASN_STRUCT_FREE(asn_DEF_NR_BCCH_DL_SCH_Message, decoded);
+}
