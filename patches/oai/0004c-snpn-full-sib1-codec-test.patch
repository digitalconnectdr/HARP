+
+static nr_mac_config_t harp_sib1_test_config(
+    bool snpn_enabled,
+    uint64_t nid)
+{
+  nr_mac_config_t config = {0};
+  config.timer_config.t300 = 1000;
+  config.timer_config.t301 = 1000;
+  config.timer_config.t310 = 1000;
+  config.timer_config.n310 = 1;
+  config.timer_config.t311 = 30000;
+  config.timer_config.n311 = 1;
+  config.timer_config.t319 = 1000;
+  config.snpn.enabled = snpn_enabled;
+  config.snpn.nid = nid;
+  return config;
+}
+
+static NR_BCCH_DL_SCH_Message_t *harp_build_and_decode_sib1(
+    bool snpn_enabled,
+    uint64_t nid)
+{
+  NR_ServingCellConfigCommon_t *scc =
+      calloc_or_fail(1, sizeof(*scc));
+  prepare_scc(scc);
+  uint64_t ssb_bitmap = 1;
+  fill_scc_sim(scc, &ssb_bitmap, 106, 106, 1, 1);
+  fix_scc(scc, ssb_bitmap);
+
+  plmn_id_t plmn = {0};
+  plmn.mcc = 999;
+  plmn.mnc = 99;
+  plmn.mnc_digit_length = 2;
+
+  nr_mac_config_t config =
+      harp_sib1_test_config(snpn_enabled, nid);
+
+  NR_BCCH_DL_SCH_Message_t *built =
+      get_SIB1_NR(scc, &plmn, 0x12345, 1, &config);
+  AssertFatal(built != NULL, "get_SIB1_NR returned NULL\n");
+
+  uint8_t encoded[4096] = {0};
+  const int encoded_len =
+      encode_SIB_NR(built, encoded, sizeof(encoded));
+  AssertFatal(encoded_len > 0, "SIB1 encoding failed\n");
+
+  NR_BCCH_DL_SCH_Message_t *decoded = NULL;
+  const asn_dec_rval_t dec = uper_decode(
+      NULL,
+      &asn_DEF_NR_BCCH_DL_SCH_Message,
+      (void **)&decoded,
+      encoded,
+      encoded_len,
+      0,
+      0);
+  AssertFatal(
+      dec.code == RC_OK && decoded != NULL,
+      "SIB1 UPER decode failed\n");
+
+  free_SIB1_NR(built);
+  ASN_STRUCT_FREE(asn_DEF_NR_ServingCellConfigCommon, scc);
+  return decoded;
+}
+
+static void assert_harp_snpn_present(
+    const NR_BCCH_DL_SCH_Message_t *decoded)
+{
+  AssertFatal(
+      decoded->message.present == NR_BCCH_DL_SCH_MessageType_PR_c1,
+      "Unexpected BCCH-DL-SCH message type\n");
+  AssertFatal(
+      decoded->message.choice.c1 != NULL
+          && decoded->message.choice.c1->present
+              == NR_BCCH_DL_SCH_MessageType__c1_PR_systemInformationBlockType1,
+      "Decoded message is not SIB1\n");
+
+  const NR_SIB1_t *sib1 =
+      decoded->message.choice.c1->choice.systemInformationBlockType1;
+  AssertFatal(sib1 != NULL, "Decoded SIB1 is NULL\n");
+
+  plmn_id_t target = {0};
+  target.mcc = 999;
+  target.mnc = 99;
+  target.mnc_digit_length = 2;
+  plmn_id_t selected = {0};
+  uint64_t selected_nid = 0;
+  AssertFatal(
+      nr_sib1_find_snpn(
+          sib1,
+          &target,
+          0x10000000001ULL,
+          &selected,
+          &selected_nid),
+      "Expected HARP SNPN identity not found after SIB1 round-trip\n");
+  AssertFatal(
+      selected.mcc == 999
+          && selected.mnc == 99
+          && selected.mnc_digit_length == 2
+          && selected_nid == 0x10000000001ULL,
+      "Unexpected HARP SNPN identity after SIB1 round-trip\n");
+}
+
+static void assert_snpn_absent(
+    const NR_BCCH_DL_SCH_Message_t *decoded)
+{
+  AssertFatal(
+      decoded->message.present == NR_BCCH_DL_SCH_MessageType_PR_c1
+          && decoded->message.choice.c1 != NULL
+          && decoded->message.choice.c1->present
+              == NR_BCCH_DL_SCH_MessageType__c1_PR_systemInformationBlockType1,
+      "Decoded baseline message is not SIB1\n");
+
+  const NR_SIB1_t *sib1 =
+      decoded->message.choice.c1->choice.systemInformationBlockType1;
+  AssertFatal(sib1 != NULL, "Decoded baseline SIB1 is NULL\n");
+  AssertFatal(
+      sib1->cellAccessRelatedInfo.ext1 == NULL
+          || sib1->cellAccessRelatedInfo.ext1->npn_IdentityInfoList_r16 == NULL,
+      "SNPN disabled but NPN identity list is present\n");
+}
+
+int main(void)
+{
+  logInit();
+
+  NR_BCCH_DL_SCH_Message_t *decoded =
+      harp_build_and_decode_sib1(true, 0x10000000001ULL);
+  assert_harp_snpn_present(decoded);
+  ASN_STRUCT_FREE(asn_DEF_NR_BCCH_DL_SCH_Message, decoded);
+
+  decoded = harp_build_and_decode_sib1(false, 0);
+  assert_snpn_absent(decoded);
+  ASN_STRUCT_FREE(asn_DEF_NR_BCCH_DL_SCH_Message, decoded);
+
+  printf("PASS_V5G_SNPN_SIB1_CODEC\n");
+  return 0;
+}
