From HARP research branch
Subject: [PATCH 1/2] NR UE: refactor serving network identity without changing PLMN behavior

Upstream anchor:
  openairinterface/openairinterface5g
  f8f769592a7030be88ede4bb5ca66fa1ca6a80e0

This is the baseline-only refactor for PASS_V5G_SNN_REFACTOR_BASELINE.
It intentionally does NOT format or populate an SNPN NID yet.

diff --git a/openair3/NAS/NR_UE/nr_nas_msg.h b/openair3/NAS/NR_UE/nr_nas_msg.h
--- a/openair3/NAS/NR_UE/nr_nas_msg.h
+++ b/openair3/NAS/NR_UE/nr_nas_msg.h
@@
 typedef struct {
   uint8_t kausf[32];
@@
 } ue_sa_security_key_t;
 
+typedef struct {
+  plmn_id_t plmn;
+  bool has_nid;
+  uint64_t nid;
+} nr_serving_network_id_t;
+
 typedef struct {
@@
   /* NAS Key Set Identifier associated to the security context */
   uint8_t *ksi;
-  plmn_id_t *sn_id;
+  nr_serving_network_id_t serving_network;
+  bool serving_network_valid;
   /* Active PDU sessions for PDU session status IE (TS 24.501 8.2.16.3 / 9.11.3.44) */
   uint8_t psi_status[MAX_NUM_PSI]; /* index 0 is spare */

diff --git a/openair2/RRC/NR_UE/rrc_UE.c b/openair2/RRC/NR_UE/rrc_UE.c
--- a/openair2/RRC/NR_UE/rrc_UE.c
+++ b/openair2/RRC/NR_UE/rrc_UE.c
@@
 static void nr_rrc_process_sib1(NR_UE_RRC_INST_t *rrc, NR_UE_RRC_SI_INFO *SI_info, NR_SIB1_t *sib1)
 {
@@
-  plmn_id_t *plmn_id = malloc_or_fail(sizeof(plmn_id_t));
+  nr_ue_nas_t *nas = get_ue_nas_info(rrc->ue_id);
+  nr_serving_network_id_t *serving_network = &nas->serving_network;
+  plmn_id_t *plmn_id = &serving_network->plmn;
+  serving_network->has_nid = false;
+  serving_network->nid = 0;
+  nas->serving_network_valid = false;
@@
-  nr_ue_nas_t *nas = get_ue_nas_info(rrc->ue_id);
-  nas->sn_id = plmn_id;
+  nas->serving_network_valid = true;

diff --git a/openair3/NAS/NR_UE/nr_nas_msg.c b/openair3/NAS/NR_UE/nr_nas_msg.c
--- a/openair3/NAS/NR_UE/nr_nas_msg.c
+++ b/openair3/NAS/NR_UE/nr_nas_msg.c
@@
-static void servingNetworkName(uint8_t *msg, plmn_id_t *plmn_id)
+static void servingNetworkName(uint8_t *msg, const nr_serving_network_id_t *sn)
 {
   // SNN-network-identifier in TS 24.501
   // TS 24.501: If the MNC of the serving PLMN has two digits, then a zero is added at the beginning.
   int size = 64;
 
+  const plmn_id_t *plmn_id = &sn->plmn;
   snprintf((char *)msg, size, "5G:mnc%03d.mcc%03d.3gppnetwork.org", plmn_id->mnc, plmn_id->mcc);
 }
@@
-void transferRES(uint8_t ck[16], uint8_t ik[16], uint8_t *input, uint8_t rand[16], uint8_t *output, plmn_id_t *plmn_id)
+void transferRES(uint8_t ck[16],
+                 uint8_t ik[16],
+                 uint8_t *input,
+                 uint8_t rand[16],
+                 uint8_t *output,
+                 const nr_serving_network_id_t *serving_network)
 {
   uint8_t S[100] = {0};
   S[0] = 0x6B;
-  servingNetworkName(S + 1, plmn_id);
+  servingNetworkName(S + 1, serving_network);
@@
-void derive_kausf(uint8_t ck[16], uint8_t ik[16], uint8_t sqn[6], uint8_t kausf[32], plmn_id_t *plmn_id)
+void derive_kausf(uint8_t ck[16],
+                  uint8_t ik[16],
+                  uint8_t sqn[6],
+                  uint8_t kausf[32],
+                  const nr_serving_network_id_t *serving_network)
 {
@@
   S[0] = 0x6A;
-  servingNetworkName(S + 1, plmn_id);
+  servingNetworkName(S + 1, serving_network);
@@
-void derive_kseaf(uint8_t kausf[32], uint8_t kseaf[32], plmn_id_t *plmn_id)
+void derive_kseaf(uint8_t kausf[32],
+                  uint8_t kseaf[32],
+                  const nr_serving_network_id_t *serving_network)
 {
@@
   S[0] = 0x6C; // FC
-  servingNetworkName(S + 1, plmn_id);
+  servingNetworkName(S + 1, serving_network);
@@
 static void derive_ue_keys(uint8_t *buf, nr_ue_nas_t *nas)
 {
@@
   DevAssert(nas != NULL);
+  AssertFatal(nas->serving_network_valid, "Serving network identity not initialized");
   uint8_t *kausf = nas->security.kausf;
@@
-  transferRES(ck, ik, resTemp, rand, output, nas->sn_id);
+  transferRES(ck, ik, resTemp, rand, output, &nas->serving_network);
@@
-  derive_kausf(ck, ik, sqn, kausf, nas->sn_id);
-  derive_kseaf(kausf, kseaf, nas->sn_id);
+  derive_kausf(ck, ik, sqn, kausf, &nas->serving_network);
+  derive_kseaf(kausf, kseaf, &nas->serving_network);

diff --git a/tests/nr-ue-nas-simulator/nr-ue-nas-simulator.c b/tests/nr-ue-nas-simulator/nr-ue-nas-simulator.c
--- a/tests/nr-ue-nas-simulator/nr-ue-nas-simulator.c
+++ b/tests/nr-ue-nas-simulator/nr-ue-nas-simulator.c
@@
   nr_ue_nas_t *nr_ue_nas = get_ue_nas_info(0);
   // serving network name (snn)
   // Ideally snn should be filled from SIB1, but we operate at NAS/RRC level and we dont decode SIB1
-  nr_ue_nas->sn_id = calloc(1, sizeof(plmn_id_t));
-  *nr_ue_nas->sn_id = plmn;
+  nr_ue_nas->serving_network.plmn = plmn;
+  nr_ue_nas->serving_network.has_nid = false;
+  nr_ue_nas->serving_network.nid = 0;
+  nr_ue_nas->serving_network_valid = true;

diff --git a/tests/nr-cu-nrppa/nr-cu-nrppa.c b/tests/nr-cu-nrppa/nr-cu-nrppa.c
--- a/tests/nr-cu-nrppa/nr-cu-nrppa.c
+++ b/tests/nr-cu-nrppa/nr-cu-nrppa.c
@@
   nr_ue_nas_t *nr_ue_nas = get_ue_nas_info(0);
   // serving network name (snn)
   // Ideally snn should be filled from SIB1, but we operate at NAS/RRC level and we dont decode SIB1
-  nr_ue_nas->sn_id = calloc(1, sizeof(plmn_id_t));
-  nr_ue_nas->sn_id->mcc = mcc;
-  nr_ue_nas->sn_id->mnc = mnc;
-  nr_ue_nas->sn_id->mnc_digit_length = mnc_len;
+  nr_ue_nas->serving_network.plmn.mcc = mcc;
+  nr_ue_nas->serving_network.plmn.mnc = mnc;
+  nr_ue_nas->serving_network.plmn.mnc_digit_length = mnc_len;
+  nr_ue_nas->serving_network.has_nid = false;
+  nr_ue_nas->serving_network.nid = 0;
+  nr_ue_nas->serving_network_valid = true;
