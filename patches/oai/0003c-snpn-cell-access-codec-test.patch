From HARP research branch
Subject: [PATCH 3c] RRC ASN.1 tests: add SNPN CellAccessRelatedInfo UPER round-trip

Depends on:
  generated NR RRC 17.3.0 headers
  0003b-gnb-snpn-sib1-encoding.patch naming/layout assumptions

Upstream anchor:
  openairinterface/openairinterface5g
  f8f769592a7030be88ede4bb5ca66fa1ca6a80e0

Purpose:
  validate the exact ASN.1 extension path and 44-bit NID through UPER before
  attempting RFsim. This test deliberately isolates CellAccessRelatedInfo from
  the rest of SIB1 radio configuration.

Gate:
  PASS_V5G_SNPN_CELL_ACCESS_CODEC

diff --git a/openair2/RRC/NR/MESSAGES/tests/test_asn1_msg.cpp b/openair2/RRC/NR/MESSAGES/tests/test_asn1_msg.cpp
--- a/openair2/RRC/NR/MESSAGES/tests/test_asn1_msg.cpp
+++ b/openair2/RRC/NR/MESSAGES/tests/test_asn1_msg.cpp
@@
 #include "NR_SIB4.h"
+#include "NR_CellAccessRelatedInfo.h"
+#include "NR_NPN-IdentityInfoList-r16.h"
+#include "NR_NPN-IdentityInfo-r16.h"
+#include "NR_NPN-Identity-r16.h"
+#include "NR_NID-r16.h"
@@
 RAN_CONTEXT_t RC;
 #ifdef __cplusplus
 }
 #endif
+
+static void set_test_plmn(NR_PLMN_Identity_t *plmn, int mcc_value, int mnc_value)
+{
+  plmn->mcc = (NR_MCC_t *)calloc_or_fail(1, sizeof(*plmn->mcc));
+  const int mcc_divisors[] = {100, 10, 1};
+  for (size_t i = 0; i < sizeofArray(mcc_divisors); ++i) {
+    auto *digit = (NR_MCC_MNC_Digit_t *)calloc_or_fail(1, sizeof(*digit));
+    *digit = (mcc_value / mcc_divisors[i]) % 10;
+    ASN_SEQUENCE_ADD(&plmn->mcc->list, digit);
+  }
+
+  const int mnc_divisors[] = {10, 1};
+  for (size_t i = 0; i < sizeofArray(mnc_divisors); ++i) {
+    auto *digit = (NR_MCC_MNC_Digit_t *)calloc_or_fail(1, sizeof(*digit));
+    *digit = (mnc_value / mnc_divisors[i]) % 10;
+    ASN_SEQUENCE_ADD(&plmn->mnc.list, digit);
+  }
+}
+
+static void set_bit_string_value(BIT_STRING_t *out, uint64_t value, size_t bytes, int bits_unused)
+{
+  ASSERT_NE(out, nullptr);
+  ASSERT_LE(bytes, sizeof(uint64_t));
+  ASSERT_GE(bits_unused, 0);
+  ASSERT_LT(bits_unused, 8);
+  const int value_bits = (int)(bytes * 8) - bits_unused;
+  ASSERT_TRUE(value_bits == 64 || value < (1ULL << value_bits));
+
+  const uint64_t shifted = value << bits_unused;
+  out->buf = (uint8_t *)calloc_or_fail(bytes, 1);
+  out->size = bytes;
+  out->bits_unused = bits_unused;
+  for (size_t i = 0; i < bytes; ++i)
+    out->buf[i] = (shifted >> (8 * (bytes - 1 - i))) & 0xff;
+}
+
+static void set_nid44(NR_NID_r16_t *nid, uint64_t value)
+{
+  ASSERT_LE(value, 0xFFFFFFFFFFFULL);
+  set_bit_string_value(nid, value, 6, 4);
+}
+
+static uint64_t get_nid44(const NR_NID_r16_t *nid)
+{
+  EXPECT_EQ(nid->size, 6u);
+  EXPECT_EQ(nid->bits_unused, 4);
+  EXPECT_EQ(nid->buf[5] & 0x0f, 0);
+  uint64_t shifted = 0;
+  for (int i = 0; i < 6; ++i)
+    shifted = (shifted << 8) | nid->buf[i];
+  return shifted >> 4;
+}
+
+TEST(nr_asn1, harp_snpn_cell_access_codec)
+{
+  NR_CellAccessRelatedInfo_t input = {};
+
+  auto *plmn_info = (NR_PLMN_IdentityInfo_t *)calloc_or_fail(1, sizeof(*plmn_info));
+  auto *public_plmn = (NR_PLMN_Identity_t *)calloc_or_fail(1, sizeof(*public_plmn));
+  set_test_plmn(public_plmn, 999, 99);
+  ASN_SEQUENCE_ADD(&plmn_info->plmn_IdentityList.list, public_plmn);
+  set_bit_string_value(&plmn_info->cellIdentity, 1, 5, 4);
+  plmn_info->cellReservedForOperatorUse =
+      NR_PLMN_IdentityInfo__cellReservedForOperatorUse_notReserved;
+  plmn_info->trackingAreaCode =
+      (NR_TrackingAreaCode_t *)calloc_or_fail(1, sizeof(*plmn_info->trackingAreaCode));
+  plmn_info->trackingAreaCode->buf = (uint8_t *)calloc_or_fail(3, 1);
+  plmn_info->trackingAreaCode->size = 3;
+  plmn_info->trackingAreaCode->bits_unused = 0;
+  plmn_info->trackingAreaCode->buf[2] = 1;
+  ASN_SEQUENCE_ADD(&input.plmn_IdentityInfoList.list, plmn_info);
+
+  input.ext1 = (decltype(input.ext1))calloc_or_fail(1, sizeof(*input.ext1));
+  input.ext1->npn_IdentityInfoList_r16 =
+      (NR_NPN_IdentityInfoList_r16_t *)calloc_or_fail(
+          1, sizeof(*input.ext1->npn_IdentityInfoList_r16));
+
+  auto *npn_info =
+      (NR_NPN_IdentityInfo_r16_t *)calloc_or_fail(1, sizeof(*npn_info));
+  ASN_SEQUENCE_ADD(&input.ext1->npn_IdentityInfoList_r16->list, npn_info);
+
+  auto *identity =
+      (NR_NPN_Identity_r16_t *)calloc_or_fail(1, sizeof(*identity));
+  ASN_SEQUENCE_ADD(&npn_info->npn_IdentityList_r16.list, identity);
+  identity->present = NR_NPN_Identity_r16_PR_snpn_r16;
+  identity->choice.snpn_r16 =
+      (decltype(identity->choice.snpn_r16))calloc_or_fail(
+          1, sizeof(*identity->choice.snpn_r16));
+  set_test_plmn(&identity->choice.snpn_r16->plmn_Identity_r16, 999, 99);
+
+  auto *nid = (NR_NID_r16_t *)calloc_or_fail(1, sizeof(*nid));
+  set_nid44(nid, 0x10000000001ULL);
+  ASN_SEQUENCE_ADD(&identity->choice.snpn_r16->nid_List_r16.list, nid);
+
+  npn_info->trackingAreaCode_r16.buf = (uint8_t *)calloc_or_fail(3, 1);
+  npn_info->trackingAreaCode_r16.size = 3;
+  npn_info->trackingAreaCode_r16.bits_unused = 0;
+  npn_info->trackingAreaCode_r16.buf[2] = 1;
+  set_bit_string_value(&npn_info->cellIdentity_r16, 1, 5, 4);
+  npn_info->cellReservedForOperatorUse_r16 =
+      NR_NPN_IdentityInfo_r16__cellReservedForOperatorUse_r16_notReserved;
+
+  char errbuf[256] = {};
+  size_t errlen = sizeof(errbuf);
+  ASSERT_EQ(
+      asn_check_constraints(
+          &asn_DEF_NR_CellAccessRelatedInfo, &input, errbuf, &errlen),
+      0) << errbuf;
+
+  void *encoded = nullptr;
+  const int encoded_len = uper_encode_to_new_buffer(
+      &asn_DEF_NR_CellAccessRelatedInfo, nullptr, &input, &encoded);
+  ASSERT_GT(encoded_len, 0);
+  ASSERT_NE(encoded, nullptr);
+
+  NR_CellAccessRelatedInfo_t *decoded = nullptr;
+  const asn_dec_rval_t dec = uper_decode(
+      nullptr,
+      &asn_DEF_NR_CellAccessRelatedInfo,
+      (void **)&decoded,
+      encoded,
+      encoded_len,
+      0,
+      0);
+  ASSERT_EQ(dec.code, RC_OK);
+  ASSERT_NE(decoded, nullptr);
+  ASSERT_NE(decoded->ext1, nullptr);
+  ASSERT_NE(decoded->ext1->npn_IdentityInfoList_r16, nullptr);
+  ASSERT_EQ(decoded->ext1->npn_IdentityInfoList_r16->list.count, 1);
+
+  const NR_NPN_IdentityInfo_r16_t *decoded_info =
+      decoded->ext1->npn_IdentityInfoList_r16->list.array[0];
+  ASSERT_EQ(decoded_info->npn_IdentityList_r16.list.count, 1);
+  const NR_NPN_Identity_r16_t *decoded_identity =
+      decoded_info->npn_IdentityList_r16.list.array[0];
+  ASSERT_EQ(decoded_identity->present, NR_NPN_Identity_r16_PR_snpn_r16);
+  ASSERT_NE(decoded_identity->choice.snpn_r16, nullptr);
+  ASSERT_EQ(decoded_identity->choice.snpn_r16->nid_List_r16.list.count, 1);
+  EXPECT_EQ(
+      get_nid44(decoded_identity->choice.snpn_r16->nid_List_r16.list.array[0]),
+      0x10000000001ULL);
+
+  free(encoded);
+  ASN_STRUCT_FREE(asn_DEF_NR_CellAccessRelatedInfo, decoded);
+  ASN_STRUCT_FREE_CONTENTS_ONLY(asn_DEF_NR_CellAccessRelatedInfo, &input);
+  printf("PASS_V5G_SNPN_CELL_ACCESS_CODEC\n");
+}
